# 1. AI & LLM Providers
# ---------------------
# GROQ_API_KEY: Primary inference engine for the Python LangGraph Portfolio Analysis Agent
# Model used: llama-3.3-70b-versatile (temperature=0.1, deterministic tool validation)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# 2. Market Data Provider
# -----------------------
# FINNHUB_API_KEY: Used to retrieve live equity quotes (/api/v1/quote) and fundamentals
# Free Tier Limit: 60 API calls / minute. Application enforces 5-minute quote caching and stale detection (>15m).
FINNHUB_API_KEY="your_finnhub_api_key_here"

# 3. Persistent Database (Neon Serverless PostgreSQL + Cloud Firestore)
# ---------------------------------------------------------------------
# NEON_DATABASE_URL: Connection string for Neon Serverless PostgreSQL (with ?sslmode=require)
NEON_DATABASE_URL="postgresql://user:password@ep-cool-darkness-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 4. Authentication & Access Control (Google OAuth 2.0 / Firebase)
# ----------------------------------------------------------------
# Used by Python MCP & FastAPI backend to verify Google OAuth 2.0 Bearer ID tokens
# and scope Firestore REST API v1 queries/commits to the authenticated user's UID.
FIREBASE_PROJECT_ID="scientific-map-p8f9p"
FIRESTORE_DATABASE_ID="ai-studio-22e05c89-9152-462c-965e-584ac1df336a"
FIREBASE_WEB_API_KEY="AIzaSyCBCjIkRDdelIPSKUZyiXzFeWuIYZzMVGk"

# 5. Deployment & Runtime Configuration
# -------------------------------------
APP_URL="https://your-project-name.vercel.app"
PORT="3000"
